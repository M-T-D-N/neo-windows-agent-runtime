+    async fn aliases(responses: Vec<(&'static str, Value)>) -> PageManager {
+        let manager = PageManager::new(TestConnection::new(responses), PageManagerHooks::default());
+        let old: browseros_cdp::browser::TabInfo =
+            serde_json::from_value(tab_json(7, "target-7")).unwrap();
+        let mut state = manager.state.lock().await;
+        for id in [1, 2] {
+            state.pages.insert(
+                crate::PageId(id),
+                super::page_info_from_tab(crate::PageId(id), old.clone(), None),
+            );
+        }
+        let other = serde_json::from_value(tab_json(8, "unrelated-target")).unwrap();
+        state.pages.insert(
+            crate::PageId(3),
+            super::page_info_from_tab(crate::PageId(3), other, None),
+        );
+        state.next_page_id = 4;
+        drop(state);
+        manager
+    }
+    fn changed_tab() -> Value {
+        let mut tab = tab_json(7, "target-7");
+        tab["url"] = json!("https://example.org/new");
+        tab["title"] = json!("New document");
+        tab["groupId"] = json!("new-group");
+        tab["windowId"] = json!(9);
+        tab["isLoading"] = json!(true);
+        tab["loadProgress"] = json!(0.4);
+        tab
+    }
+    async fn assert_aliases_current(manager: &PageManager) {
+        let state = manager.state.lock().await;
+        for id in [1, 2] {
+            let p = &state.pages[&crate::PageId(id)];
+            assert_eq!(p.url, "https://example.org/new");
+            assert_eq!(p.title, "New document");
+            assert_eq!(p.group_id.as_deref(), Some("new-group"));
+            assert_eq!(p.window_id, Some(crate::WindowId(9)));
+            assert!(p.is_loading);
+            assert_eq!(p.load_progress, 0.4);
+        }
+        assert_eq!(state.pages[&crate::PageId(3)].url, "https://example.com");
+        assert_eq!(state.pages.len(), 3);
+    }
+    #[tokio::test]
+    async fn alias_list_updates_all_old_handles_and_keeps_unrelated_pages()
+    -> Result<(), Box<dyn Error>> {
+        let manager = aliases(vec![(
+            "Browser.getTabs",
+            json!({"tabs":[changed_tab(),tab_json(8,"unrelated-target")]}),
+        )])
+        .await;
+        let pages = manager.list().await?;
+        assert_eq!(pages.len(), 3);
+        assert_aliases_current(&manager).await;
+        Ok(())
+    }
+    #[tokio::test]
+    async fn alias_refresh_updates_all_old_handles() -> Result<(), Box<dyn Error>> {
+        let manager = aliases(vec![("Browser.getTabInfo", json!({"tab":changed_tab()}))]).await;
+        manager.refresh(crate::PageId(2)).await?;
+        assert_aliases_current(&manager).await;
+        Ok(())
+    }
+    #[tokio::test]
+    async fn alias_move_update_updates_all_old_handles() -> Result<(), Box<dyn Error>> {
+        let manager = aliases(vec![]).await;
+        manager
+            .update_from_tab(crate::PageId(2), serde_json::from_value(changed_tab())?)
