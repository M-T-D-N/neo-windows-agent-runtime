+    struct InterleavedConnection {
+        inner: std::sync::Arc<TestConnection>,
+        ready: tokio::sync::Notify,
+        resume: tokio::sync::Notify,
+    }
+    impl crate::CdpConnection for InterleavedConnection {
+        fn send<'a>(
+            &'a self,
+            method: &'a str,
+            params: Value,
+            session: Option<&'a crate::SessionId>,
+        ) -> futures_util::future::BoxFuture<'a, Result<Value, browseros_cdp::CdpError>> {
+            Box::pin(async move {
+                if method == "Browser.getTabInfo" {
+                    self.ready.notify_one();
+                    self.resume.notified().await;
+                }
+                self.inner.send(method, params, session).await
+            })
+        }
+        fn send_raw_json<'a>(
+            &'a self,
+            method: &'a str,
+            params: &'a str,
+            session: Option<&'a crate::SessionId>,
+        ) -> futures_util::future::BoxFuture<'a, Result<String, browseros_cdp::CdpError>> {
+            Box::pin(async move {
+                let v = self
+                    .send(method, serde_json::from_str(params)?, session)
+                    .await?;
+                Ok(serde_json::to_string(&v)?)
+            })
+        }
+        fn events(&self) -> tokio::sync::broadcast::Receiver<browseros_cdp::CdpEvent> {
+            self.inner.events()
+        }
+        fn is_connected(&self) -> bool {
+            true
+        }
+        fn connection_epoch(&self) -> u64 {
+            1
+        }
+    }
+
+    #[tokio::test]
+    async fn alias_creation_racing_list_reuses_the_existing_page_id() -> Result<(), Box<dyn Error>>
+    {
+        let connection = std::sync::Arc::new(InterleavedConnection {
+            inner: TestConnection::new([
+                (
+                    "Browser.getWindows",
+                    json!({"windows":[window_json(3,"normal",true,false)]}),
+                ),
+                ("Browser.createTab", json!({"tab":tab_json(7,"target-7")})),
+                ("Browser.getTabInfo", json!({"tab":tab_json(7,"target-7")})),
+                ("Browser.getTabs", json!({"tabs":[tab_json(7,"target-7")]})),
+            ]),
+            ready: Default::default(),
+            resume: Default::default(),
+        });
+        let manager = std::sync::Arc::new(PageManager::new(
+            connection.clone(),
+            PageManagerHooks::default(),
+        ));
+        let producer = manager.clone();
+        let pending = tokio::spawn(async move {
+            producer
+                .new_page("https://example.com", NewPageOptions::default())
+                .await
+        });
+        tokio::time::timeout(
+            std::time::Duration::from_secs(2),
+            connection.ready.notified(),
+        )
+        .await?;
+        let listed = manager.list().await?;
+        let earlier = listed[0].page_id.clone();
+        connection.resume.notify_one();
+        let created = pending.await??;
+        assert_eq!(created, earlier);
+        let state = manager.state.lock().await;
+        assert_eq!(state.pages.len(), 1);
+        assert!(state.agent_created.contains(&earlier));
+        Ok(())
+    }
