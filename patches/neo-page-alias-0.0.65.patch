+// Alias handles remain valid; only their current physical metadata is shared.
+// Ownership/claims and detach hooks are deliberately untouched.
+fn sync_physical_aliases(
+    state: &mut PageState,
+    page_id: PageId,
+    tab: browser::TabInfo,
+) -> PageInfo {
+    let prior_window = state.pages.get(&page_id).and_then(|p| p.window_id.clone());
+    let updated = page_info_from_tab(page_id.clone(), tab, prior_window);
+    let aliases = state
+        .pages
+        .values()
+        .filter(|p| {
+            p.page_id == page_id || p.target_id == updated.target_id || p.tab_id == updated.tab_id
+        })
+        .map(|p| p.page_id.clone())
+        .chain(std::iter::once(page_id.clone()))
+        .collect::<HashSet<_>>();
+    for id in aliases {
+        if let Some(prior) = state.pages.get(&id) {
+            if prior.target_id != updated.target_id {
+                state.sessions.remove(&prior.target_id);
+            }
+        }
+        let mut info = updated.clone();
+        info.page_id = id.clone();
+        state.pages.insert(id, info);
+    }
+    updated
