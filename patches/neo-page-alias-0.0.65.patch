+    }
+    #[tokio::test]
+    async fn alias_target_rebind_invalidates_only_the_previous_session()
+    -> Result<(), Box<dyn Error>> {
+        let mut tab = changed_tab();
+        tab["targetId"] = json!("replacement-target");
+        let manager = aliases(vec![(
+            "Browser.getTabs",
+            json!({"tabs":[tab,tab_json(8,"unrelated-target")]}),
+        )])
+        .await;
+        {
+            let mut state = manager.state.lock().await;
+            state.sessions.insert(
+                crate::TargetId("target-7".into()),
+                crate::SessionId::from("old-session"),
+            );
+            state.sessions.insert(
+                crate::TargetId("unrelated-target".into()),
+                crate::SessionId::from("other-session"),
+            );
+            state.agent_created.insert(crate::PageId(2));
+        }
+        manager.list().await?;
+        assert_aliases_current(&manager).await;
+        let state = manager.state.lock().await;
+        for id in [1, 2] {
+            assert_eq!(
+                state.pages[&crate::PageId(id)].target_id,
+                crate::TargetId("replacement-target".into())
+            );
+        }
+        assert!(
+            !state
+                .sessions
+                .contains_key(&crate::TargetId("target-7".into()))
+        );
+        assert!(
+            state
+                .sessions
+                .contains_key(&crate::TargetId("unrelated-target".into()))
+        );
+        assert!(state.agent_created.contains(&crate::PageId(2)));
+        Ok(())
+    }
