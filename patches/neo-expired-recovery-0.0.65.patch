+
+async fn idle_owner_in<C:ConnectionTrait>(conn:&C, prior_session:&str,
+    tabs:&[(i64,String)]) -> AppResult<Option<(String,String)>>
+{
+        if tabs.is_empty()
+            || tabs.iter().map(|(tab, _)| tab).collect::<std::collections::BTreeSet<_>>().len() != tabs.len()
+        {
+            return Ok(None);
+        }
+        let starts = AgentSessionStarts::find()
+            .filter(agent_session_starts::Column::SessionId.eq(prior_session))
+            .all(conn).await?;
+        let ends = AgentSessionEnds::find()
+            .filter(agent_session_ends::Column::SessionId.eq(prior_session))
+            .all(conn).await?;
+        let ([start], [end]) = (starts.as_slice(), ends.as_slice()) else { return Ok(None) };
+        if end.kind != "closed" || end.reason.as_deref() != Some("idle timeout")
+            || end.created_at < start.created_at
+        {
+            return Ok(None);
+        }
+        for (tab, target) in tabs {
+            let Some(last) = SessionTabs::find()
+                .filter(session_tabs::Column::TabId.eq(*tab))
+                .order_by_desc(session_tabs::Column::Id)
+                .one(conn).await? else { return Ok(None) };
+            if target.is_empty() || last.session_id != prior_session || last.agent_id != start.agent_id
+                || last.opened_target_id.as_deref() != Some(target.as_str())
+                || last.released_at.is_none_or(|released| released < last.claimed_at || released > end.created_at)
+            {
+                return Ok(None);
+            }
+        }
+        Ok(Some((start.agent_id.clone(), start.client_name.clone())))
+    }
