+    /// Admission, final physical validation and all ownership-index updates are one CAS.
+    pub async fn reclaim_pages_if_unchanged<F>(
+        &self,
+        owner: &ConvoId,
+        expected: &[(PageId, Option<ConvoId>)],
+        group_ref: &str,
+        validate: F,
+    ) -> Result<(), String>
+    where F: std::future::Future<Output = Result<(), String>>,
+    {
+        let mut inner = self.inner.write().await;
+        if expected.is_empty()
+            || expected.iter().map(|(page, _)| page).collect::<BTreeSet<_>>().len() != expected.len()
+            || expected.iter().any(|(page, prior)| inner.page_owners.get(page) != prior.as_ref())
+        {
+            return Err("Recovery ownership changed during admission".into());
+        }
+        validate.await?;
+        for (page, _) in expected {
+            if let Some(previous) = inner.page_owners.insert(page.clone(), owner.clone())
+                && previous != *owner
+                && let Some(convo) = inner.convos.get_mut(&previous)
+            {
+                convo.pages.remove(page);
