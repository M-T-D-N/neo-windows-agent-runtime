+        let current_session=current_session.clone();let expected=expected.to_vec();let tabs=tabs.to_vec();
+        // Once the durable claim transaction starts, finish its matching memory
+        // update even if the HTTP waiter disappears. Cancellation before that
+        // boundary makes no changes; after it, the caller must reconcile.
+        tokio::spawn(async move {
+        let live = registry.sessions.read().await;
+        let current = live.get(&current_session).ok_or("Recovery caller is not active")?;
