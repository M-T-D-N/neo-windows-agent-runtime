+    /// Keep lifecycle admission stable through the ownership CAS: a same-client live
+    /// conversation is just as protected as a different-client conversation.
+    pub async fn reclaim_idle_pages<F>(
+        self: &Arc<Self>,
+        prior_session: &SessionId,
+        current_session: &SessionId,
+        expected: &[(browseros_core::PageId, Option<ConvoId>)],
+        tabs: &[(i64, String)],
+        group_ref: String,
+        cancel: CancellationToken,
