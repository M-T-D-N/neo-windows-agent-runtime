+            if conflict {
+                // A second alias belonging to another live task must veto the whole transfer.
+                call.state
+                    .sessions
+                    .ownership()
+                    .claim_page(
+                        call.identity.as_ref().unwrap().ownership_key.clone(),
+                        alias.clone(),
+                    )
+                    .await;
+            }
+            let before = call.state.sessions.owner_of_page(&original).await;
+            let result = reclaim_enabled(&call).await;
+            assert_eq!(result.is_error, conflict, "{result:?}");
+            if conflict {
+                assert_eq!(call.state.sessions.owner_of_page(&original).await, before);
+                assert!(
+                    call.state
+                        .session_tabs
+                        .list_open_session_tabs(&[call.session_id.as_str().into()])
+                        .await?
+                        .is_empty()
+                );
+            } else {
+                let mine = call.identity.as_ref().map(|i| i.ownership_key.clone());
+                assert_eq!(call.state.sessions.owner_of_page(&original).await, mine);
+                assert_eq!(call.state.sessions.owner_of_page(&alias).await, mine);
+                assert_eq!(
+                    call.state
+                        .session_tabs
+                        .list_open_session_tabs(&[call.session_id.as_str().into()])
+                        .await?
+                        .len(),
+                    1
+                );
+            }
+            assert!(
+                recorder
+                    .calls
+                    .lock()
+                    .unwrap()
+                    .iter()
+                    .all(|m| m == "Browser.getTabs" || m == "Browser.getTabGroups")
+            );
+        }
+        Ok(())
+    }
