+        let (call, _, page) = fixture(true, true, false).await?;
+        let prior = call.state.sessions.owner_of_page(&page).await.unwrap();
+        let entered = Arc::new(Semaphore::new(0));
+        let release = Arc::new(Semaphore::new(0));
+        let registry = call.state.sessions.clone();
+        let current = call.session_id.clone();
+        let expected = vec![(page.clone(), Some(prior.clone()))];
+        let entered_work = entered.clone();
+        let release_work = release.clone();
+        let recovery = tokio::spawn(async move {
+            registry
+                .reclaim_idle_pages(
+                    &SessionId::new("prior-task"),
+                    &current,
+                    &expected,
+                    &[(101, "writer-target".into())],
+                    "saved-group".into(),
+                    tokio_util::sync::CancellationToken::new(),
+                    async move {
+                        entered_work.add_permits(1);
+                        release_work
+                            .acquire()
+                            .await
+                            .map_err(|e| e.to_string())?
+                            .forget();
+                        Ok(())
+                    },
+                )
+                .await
+        });
+        tokio::time::timeout(std::time::Duration::from_secs(2), entered.acquire())
+            .await??
+            .forget();
+        let reactivated = Session::new(
+            SessionId::new("reactivated"),
+            ClientIdentity::Ephemeral {
+                slug: "codex".into(),
+                label: "Codex".into(),
+            },
+            ConversationIdentity::new(
+                "codex",
+                prior.as_str().strip_prefix("codex-").unwrap().to_owned(),
+            ),
+            "Codex".into(),
+            tokio::time::Instant::now(),
+        );
+        let registry = call.state.sessions.clone();
+        let attempted = Arc::new(Semaphore::new(0));
+        let attempted_work = attempted.clone();
+        let activation = tokio::spawn(async move {
+            attempted_work.add_permits(1);
+            registry.insert_for_testing(reactivated).await;
+        });
+        tokio::time::timeout(std::time::Duration::from_secs(2), attempted.acquire())
+            .await??
+            .forget();
+        assert!(!activation.is_finished());
+        release.add_permits(1);
+        assert!(recovery.await?.is_ok());
+        activation.await?;
+        assert_eq!(
+            call.state.sessions.owner_of_page(&page).await,
+            call.identity.as_ref().map(|i| i.ownership_key.clone())
+        );
+        Ok(())
+    }
