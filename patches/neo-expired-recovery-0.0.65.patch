+            {
+                return Err("Recovery owner is active, unknown, unclaimed or from another client".into());
+            }
+            validate_physical.await?;
+            if cancel.is_cancelled() {return Err("Recovery cancelled before commit".into())}
+            if !registry.session_tabs.record_idle_recovery(prior_session.as_str(),current_session.as_str(),
+                current.convo_id().as_str(),owner.as_str(),&client,&tabs).await.map_err(|e|e.to_string())? {
+                return Err("Recovery claim changed before commit".into());
+            }
+            Ok(())
+        }).await?;
+        Ok(())
+        }).await.map_err(|e|e.to_string())?
