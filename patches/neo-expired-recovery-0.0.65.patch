+//! Explicit Workspace continuation of one positively proven idle-expired task.
+//! Never opens, activates, reloads, focuses or edits a page.
+use crate::{api::mcp::dispatch::ToolCall, ids::SessionId};
+use browseros_core::{BrowserSession, pages::PageInfo};
+use browseros_mcp::ToolResult;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    action: String,
+    #[serde(rename = "groupId")]
+    group_id: String,
+    #[serde(rename = "priorSession")]
+    prior_session: String,
+    expected: Vec<browseros_mcp::tools::tabs::RecoveryTarget>,
+}
+
+async fn exact_group(
+    browser: &BrowserSession,
+    group: &str,
+    expected: &BTreeMap<String, String>,
+) -> Result<Vec<PageInfo>, String> {
+    let inventory = browser.pages.list().await.map_err(|e| e.to_string())?;
+    // The SDK can retain multiple handles for one physical target. Validate
+    // every alias, including one whose stale group label differs, and CAS all
+    // of their owners. Never hide a conflicting alias by choosing one handle.
+    let relevant_tabs: BTreeSet<_> = inventory
+        .iter()
+        .filter(|p| expected.contains_key(p.target_id.as_str()))
+        .map(|p| p.tab_id.0)
+        .collect();
+    let pages: Vec<_> = inventory
+        .into_iter()
+        .filter(|p| {
+            p.group_id.as_deref() == Some(group)
+                || expected.contains_key(p.target_id.as_str())
+                || relevant_tabs.contains(&p.tab_id.0)
+        })
+        .collect();
+    let actual: BTreeMap<_, _> = pages
+        .iter()
+        .map(|p| (p.target_id.as_str().to_owned(), p.url.clone()))
+        .collect();
+    if actual != *expected
+        || pages.iter().any(|p| {
+            p.group_id.as_deref() != Some(group)
+                || expected.get(p.target_id.as_str()) != Some(&p.url)
+        })
+    {
+        return Err("Recovery group membership or URL changed".into());
+    }
+    let mut physical_targets = BTreeMap::new();
+    let mut physical_tabs = BTreeMap::new();
+    for p in &pages {
+        if physical_targets
+            .insert(p.target_id.as_str(), p.tab_id.0)
+            .is_some_and(|id| id != p.tab_id.0)
+            || physical_tabs
+                .insert(p.tab_id.0, p.target_id.as_str())
+                .is_some_and(|id| id != p.target_id.as_str())
+        {
+            return Err("Recovery physical aliases disagree".into());
+        }
+    }
+    let window = pages
+        .first()
+        .and_then(|p| p.window_id.clone())
+        .ok_or("Recovery group has no window")?;
+    if pages.iter().any(|p| p.window_id.as_ref() != Some(&window)) {
+        return Err("Recovery group spans windows".into());
+    }
+    let native = browser
+        .cdp("Browser.getTabGroups", json!({}), None)
+        .await
+        .map_err(|e| e.to_string())?;
+    let groups = native
+        .get("groups")
+        .and_then(Value::as_array)
+        .ok_or("Recovery native group inventory is unavailable")?;
+    let matched: Vec<_> = groups
+        .iter()
+        .filter(|g| g.get("groupId").and_then(Value::as_str) == Some(group))
+        .collect();
+    let [matched] = matched.as_slice() else {
+        return Err("Recovery group is absent or ambiguous".into());
+    };
+    let ids = matched
+        .get("tabIds")
+        .and_then(Value::as_array)
+        .ok_or("Recovery native group members are unavailable")?;
+    let physical: Option<BTreeSet<_>> = ids.iter().map(Value::as_i64).collect();
+    let wanted: BTreeSet<_> = pages.iter().map(|p| p.tab_id.0).collect();
+    if physical.as_ref() != Some(&wanted) || ids.len() != wanted.len() {
+        return Err("Recovery group has extra or missing native members".into());
+    }
+    Ok(pages)
+}
+
+pub async fn reclaim(call: &ToolCall) -> ToolResult {
+    if !crate::config::workspace_manual_tab_cleanup() {
+        return ToolResult::error("Workspace expired-task recovery is not enabled");
+    }
+    reclaim_enabled(call).await
+}
+
+async fn reclaim_enabled(call: &ToolCall) -> ToolResult {
+    let work = async {
+        let request: Request =
+            serde_json::from_value(call.raw_args.clone()).map_err(|e| e.to_string())?;
+        if request.action != "reclaim_expired"
+            || request.group_id.is_empty()
+            || request.prior_session.is_empty()
+            || request.expected.is_empty()
+        {
+            return Err("Exact task handle and nonempty recovery membership are required".into());
+        }
+        let expected: BTreeMap<_, _> = request
+            .expected
+            .iter()
+            .map(|p| (p.target_id.clone(), p.url.clone()))
+            .collect();
+        if expected.len() != request.expected.len()
+            || expected
+                .iter()
+                .any(|(target, url)| target.is_empty() || url.is_empty())
+        {
+            return Err("Duplicate or empty recovery target identity".into());
+        }
+        let identity = call
+            .identity
+            .as_ref()
+            .ok_or("Recovery requires a task identity")?;
+        let browser = call.browser_session.as_ref().ok_or("Browser unavailable")?;
+        let ownership = call.state.sessions.ownership();
+        let group_lock = ownership
+            .group_operation_lock(&identity.ownership_key)
+            .await;
+        let _guard = group_lock.lock().await;
+        let pages = exact_group(browser, &request.group_id, &expected).await?;
+        let mut owners = Vec::new();
+        for page in &pages {
+            let owner = ownership.owner_of_page(&page.page_id).await;
+            owners.push((page.page_id.clone(), owner));
+        }
+        let tabs: Vec<_> = pages
+            .iter()
+            .map(|p| (p.tab_id.0, p.target_id.as_str().to_owned()))
+            .collect::<BTreeSet<_>>()
+            .into_iter()
+            .collect();
+        let browser_check = browser.clone();
+        let group_check = request.group_id.clone();
+        let original: BTreeSet<_> = pages
+            .iter()
+            .map(|p| {
+                (
+                    p.page_id.0,
+                    p.tab_id.0,
+                    p.target_id.as_str().to_owned(),
+                    p.url.clone(),
+                    p.group_id.clone(),
+                    p.window_id.clone(),
+                )
+            })
+            .collect();
+        call.state
+            .sessions
+            .reclaim_idle_pages(
+                &SessionId::new(request.prior_session),
+                &call.session_id,
+                &owners,
+                &tabs,
+                request.group_id.clone(),
+                call.cancel.clone(),
+                async move {
+                    let current = tokio::time::timeout(
+                        crate::api::mcp::timeouts::TAB_GROUP_OPERATION,
+                        exact_group(&browser_check, &group_check, &expected),
+                    )
+                    .await
+                    .map_err(|_| "Recovery physical validation timed out".to_string())??;
+                    let fingerprint: BTreeSet<_> = current
+                        .iter()
+                        .map(|p| {
+                            (
+                                p.page_id.0,
+                                p.tab_id.0,
+                                p.target_id.as_str().to_owned(),
+                                p.url.clone(),
+                                p.group_id.clone(),
+                                p.window_id.clone(),
+                            )
+                        })
+                        .collect();
+                    if fingerprint != original {
+                        return Err("Recovery physical incarnation changed".into());
+                    }
+                    Ok(())
+                },
+            )
+            .await?;
+        Ok::<_, String>(ToolResult::text(
+            "Verified idle-expired task ownership restored without page changes",
+            Some(
+                json!({"action":"reclaim_expired","groupId":request.group_id,
+                "pages":pages.iter().map(|p|p.page_id.0).collect::<Vec<_>>()}),
+            ),
+        ))
+    };
+    match work.await {
+        Ok(result) => result,
+        Err(error) => ToolResult::error(format!("reclaim_expired: {error}")),
+    }
+}
