+    /// Positive continuation proof, not absence from an in-memory live snapshot.
+    /// Caller also holds the live-session and ownership locks while admitting.
+    pub async fn idle_owner_for_tabs(
+        &self,
+        prior_session: &str,
+        tabs: &[(i64, String)],
+    ) -> AppResult<Option<(String, String)>> {
+        self.drain_writes().await;
+        idle_owner_in(self.db.connection(), prior_session, tabs).await
+    }
+
+    /// Write the complete new claim set in one transaction and propagate failure.
+    pub async fn record_idle_recovery(&self, prior_session: &str, current_session: &str,
+        current_owner: &str, old_owner: &str, client: &str, tabs: &[(i64,String)]) -> AppResult<bool>
+    {
+        let txn=self.db.connection().begin().await?;
+        if idle_owner_in(&txn,prior_session,tabs).await? != Some((old_owner.to_owned(),client.to_owned())) {
+            return Ok(false);
+        }
+        let claimed=now_epoch_ms();
+        for (tab,target) in tabs {
+            SessionTabs::insert(session_tabs::ActiveModel {
+                id:NotSet, session_id:Set(current_session.to_owned()),agent_id:Set(current_owner.to_owned()),
+                tab_id:Set(*tab),opened_target_id:Set(Some(target.clone())),claimed_at:Set(claimed),released_at:Set(None),
+            }).exec(&txn).await?;
+        }
+        txn.commit().await?;
+        Ok(true)
+    }
