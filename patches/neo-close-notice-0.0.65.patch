+    // Effect-only fixtures represent a page known to exist at admission.
+    // Detached/unknown fixtures below supply (or omit) their snapshot explicitly.
+    async fn run_known_live_page(
+        call: &crate::api::mcp::dispatch::ToolCall,
+        result: &ToolResult,
+    ) -> Option<ToolResult> {
+        let mut admitted = call.clone();
+        let page = PageId(extract_page_id(call).expect("page-targeted fixture"));
+        admitted.page_owner_snapshot = Some(call.state.sessions.owner_of_page(&page).await);
+        run(&admitted, result).await
+    }
+
+    #[tokio::test]
+    async fn detached_dialog_accept_keeps_admission_owner() -> anyhow::Result<()> {
+        // The browser connection's on_page_detached hook can remove the claim
+        // before this effect, independently of the tabs-close ownership effect.
+        for kind in ["own", "other", "user"] {
+            let mut call = crate::api::mcp::test_support::tool_call(
+                "act",
+                json!({"page": 7, "kind": "dialog_accept"}),
+            )
+            .await?;
+            let owner = match kind {
+                "own" => Some(
+                    call.identity
+                        .as_ref()
+                        .expect("identity")
+                        .ownership_key
+                        .clone(),
+                ),
+                "other" => Some(ConvoId::new("other-dialog-client")),
+                _ => None,
+            };
+            if let Some(owner) = &owner {
+                call.state
+                    .sessions
+                    .ownership()
+                    .claim_page(owner.clone(), PageId(7))
+                    .await;
+            }
+            call.page_owner_snapshot = Some(owner);
+            call.state
+                .sessions
+                .ownership()
+                .remove_page(&PageId(7))
+                .await;
+            assert!(!call.flags.close_page);
+            let result = run(&call, &ToolResult::text("ok (dialog_accept)", None)).await;
+            match kind {
+                "own" => assert!(
+                    result.is_none(),
+                    "detached own page must stay own: {result:?}"
+                ),
+                "other" => {
+                    let text = text_of(&result.expect("other owner notice"));
+                    assert!(
+                        text.contains("belongs to another agent")
+                            && !text.contains("user's own tabs"),
+                        "{text}"
+                    );
+                }
+                _ => assert!(text_of(&result.expect("user notice")).contains("user's own tabs")),
+            }
+            assert!(
+                call.state
+                    .sessions
+                    .owner_of_page(&PageId(7))
+                    .await
+                    .is_none()
+            );
+        }
+        Ok(())
+    }
