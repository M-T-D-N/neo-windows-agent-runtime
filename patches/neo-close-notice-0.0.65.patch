+    #[tokio::test]
+    async fn successful_close_keeps_user_and_other_attribution() -> anyhow::Result<()> {
+        for owner in [None, Some(ConvoId::new("another-agent-prior"))] {
+            let mut call = crate::api::mcp::test_support::tool_call(
+                "tabs",
+                json!({"action":"close", "page":7}),
+            )
+            .await?;
+            if let Some(owner) = &owner {
+                call.state
+                    .sessions
+                    .ownership()
+                    .claim_page(owner.clone(), PageId(7))
+                    .await;
+            }
+            call.page_owner_snapshot = Some(owner.clone());
+            let ok = ToolResult::text("closed page 7", None);
+            crate::api::mcp::effects::ownership_claims::apply(ToolEffectContext {
+                call: &call,
+                result: &ok,
+                cancelled: false,
+                duration_ms: 1,
+            })
+            .await?;
+            assert!(
+                call.state
+                    .sessions
+                    .owner_of_page(&PageId(7))
+                    .await
+                    .is_none()
+            );
+            let annotated = run(&call, &ok).await.expect("foreign attribution");
+            let text = text_of(&annotated);
+            assert_eq!(text.contains("user's own tabs"), owner.is_none(), "{text}");
+            assert_eq!(text.contains("another agent"), owner.is_some(), "{text}");
+        }
+        Ok(())
+    }
