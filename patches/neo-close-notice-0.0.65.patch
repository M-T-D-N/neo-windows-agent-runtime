+    #[tokio::test]
+    async fn successful_close_preserves_own_attribution() -> anyhow::Result<()> {
+        let mut call =
+            crate::api::mcp::test_support::tool_call("tabs", json!({"action":"close", "page":9}))
+                .await?;
+        let owner = call
+            .identity
+            .as_ref()
+            .expect("identity")
+            .ownership_key
+            .clone();
+        call.state
+            .sessions
+            .ownership()
+            .claim_page(owner.clone(), PageId(9))
+            .await;
+        call.page_owner_snapshot = Some(Some(owner));
+        let ok = ToolResult::text("closed page 9", None);
+        crate::api::mcp::effects::ownership_claims::apply(ToolEffectContext {
+            call: &call,
+            result: &ok,
+            cancelled: false,
+            duration_ms: 1,
+        })
+        .await?;
+        assert!(
+            call.state
+                .sessions
+                .owner_of_page(&PageId(9))
+                .await
+                .is_none()
+        );
+        let annotated = run(&call, &ok).await;
+        assert!(
+            annotated.is_none(),
+            "own close must not be relabelled: {annotated:?}"
+        );
+        Ok(())
+    }
