+// Windows-only restoration that never calls SetForegroundWindow or activates Neo.
+// These FFI calls are confined here; the caller proves a unique existing CDP
+// normal window and derives the browser PID from that same CDP connection.
+use std::{ffi::c_void, thread, time::Duration};
+type Hwnd = *mut c_void;
+#[link(name = "user32")]
+unsafe extern "system" {
+    fn EnumWindows(callback: unsafe extern "system" fn(Hwnd, isize) -> i32, data: isize) -> i32;
+    fn GetWindowThreadProcessId(window: Hwnd, pid: *mut u32) -> u32;
+    fn GetClassNameW(window: Hwnd, name: *mut u16, count: i32) -> i32;
+    fn GetWindow(window: Hwnd, command: u32) -> Hwnd;
+    fn GetForegroundWindow() -> Hwnd;
+    fn GetWindowLongPtrW(window: Hwnd, index: i32) -> isize;
+    fn IsWindow(window: Hwnd) -> i32;
+    fn IsIconic(window: Hwnd) -> i32;
+    fn IsWindowVisible(window: Hwnd) -> i32;
+    fn SetWindowPos(
+        window: Hwnd,
+        after: Hwnd,
+        x: i32,
+        y: i32,
+        width: i32,
+        height: i32,
+        flags: u32,
+    ) -> i32;
+    fn ShowWindowAsync(window: Hwnd, command: i32) -> i32;
+}
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> *mut c_void;
+    fn GetExitCodeProcess(process: *mut c_void, code: *mut u32) -> i32;
+    fn CloseHandle(handle: *mut c_void) -> i32;
+}
+struct Process(usize);
+impl Drop for Process {
+    fn drop(&mut self) {
+        unsafe {
+            CloseHandle(self.0 as *mut c_void);
+        }
+    }
+}
+struct Search {
+    pid: u32,
+    windows: Vec<Hwnd>,
+}
+unsafe extern "system" fn enumerate(window: Hwnd, data: isize) -> i32 {
+    // EnumWindows calls synchronously; data points to this call's live Search.
+    let search = unsafe { &mut *(data as *mut Search) };
+    let mut pid = 0;
+    unsafe {
+        GetWindowThreadProcessId(window, &mut pid);
+    }
+    if pid == search.pid && unsafe { GetWindow(window, 4) }.is_null() {
+        let mut name = [0u16; 64];
+        let count = unsafe { GetClassNameW(window, name.as_mut_ptr(), name.len() as i32) };
+        if count > 0 && String::from_utf16_lossy(&name[..count as usize]) == "Chrome_WidgetWin_1" {
+            search.windows.push(window);
+        }
+    }
+    1
+}
+fn owner(window: Hwnd) -> u32 {
+    let mut pid = 0;
+    unsafe {
+        GetWindowThreadProcessId(window, &mut pid);
+    }
+    pid
+}
+fn behind(window: Hwnd, foreground: Hwnd) -> bool {
+    let mut cursor = foreground;
+    for _ in 0..512 {
+        cursor = unsafe { GetWindow(cursor, 2) };
+        if cursor.is_null() {
+            return false;
+        }
+        if cursor == window {
+            return true;
+        }
+    }
+    false
+}
+fn live(process: &Process) -> bool {
+    let mut code = 0;
+    unsafe { GetExitCodeProcess(process.0 as *mut c_void, &mut code) != 0 && code == 259 }
+}
+pub(crate) struct WindowTicket {
+    pid: u32,
+    window: usize,
+    thread: u32,
+    process: Process,
+}
+fn candidates(pid: u32) -> Result<Vec<usize>, String> {
+    let mut search = Search {
+        pid,
+        windows: Vec::new(),
+    };
+    if unsafe { EnumWindows(enumerate, (&mut search as *mut Search) as isize) } == 0 {
+        return Err("Cannot enumerate existing browser windows".into());
+    }
+    Ok(search.windows.into_iter().map(|w| w as usize).collect())
+}
+pub(crate) fn capture(pid: u32) -> Result<WindowTicket, String> {
+    let process = Process(unsafe { OpenProcess(0x1000, 0, pid) } as usize);
+    if process.0 == 0 || !live(&process) {
+        return Err("Browser process identity unavailable".into());
+    }
+    let windows = candidates(pid)?;
+    if windows.len() != 1 {
+        return Err("Cannot identify one existing native browser window".into());
+    }
+    let window = windows[0];
+    let mut observed = 0;
+    let thread = unsafe { GetWindowThreadProcessId(window as Hwnd, &mut observed) };
+    if observed != pid || thread == 0 {
+        return Err("Browser window identity unavailable".into());
+    }
+    Ok(WindowTicket {
+        pid,
+        window,
+        thread,
+        process,
+    })
+}
+fn validate(ticket: &WindowTicket) -> Result<(), String> {
+    let windows = candidates(ticket.pid)?;
+    let mut pid = 0;
+    let thread = unsafe { GetWindowThreadProcessId(ticket.window as Hwnd, &mut pid) };
+    if windows != vec![ticket.window]
+        || pid != ticket.pid
+        || thread != ticket.thread
+        || !live(&ticket.process)
+    {
+        return Err(
+            "Native browser window was replaced or became ambiguous; no action dispatched".into(),
+        );
+    }
+    Ok(())
+}
+pub(crate) fn restore(ticket: WindowTicket) -> Result<(), String> {
+    validate(&ticket)?;
+    let window = ticket.window as Hwnd;
+    let pid = ticket.pid;
+    let process = &ticket.process;
+    let foreground = unsafe { GetForegroundWindow() };
+    if foreground.is_null() || foreground == window || unsafe { IsWindow(foreground) } == 0 {
+        return Err("Foreground unavailable or changed; leave window untouched".into());
+    }
+    // Do not silently alter an explicit always-on-top setting.
+    if unsafe { GetWindowLongPtrW(window, -20) } & 8 != 0 {
+        return Err("Topmost window requires explicit handling; no restoration dispatched".into());
+    }
+    if owner(window) != pid || !live(process) {
+        return Err("Browser window identity changed".into());
+    }
+    validate(&ticket)?;
+    // Queue a non-activating placement at HWND_BOTTOM before show. This never
+    // uses another app's HWND as an insertion target (including fullscreen games).
+    // NOSIZE|NOMOVE|NOACTIVATE|NOOWNERZORDER|ASYNCWINDOWPOS.
+    if unsafe { SetWindowPos(window, 1usize as Hwnd, 0, 0, 0, 0, 0x4213) } == 0 {
+        return Err(format!(
+            "Background placement failed; no show dispatched: {}",
+            std::io::Error::last_os_error()
+        ));
+    }
+    for _ in 0..50 {
+        if behind(window, foreground) {
+            break;
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+    if !behind(window, foreground) {
+        return Err("Background Z-order not confirmed; no show dispatched".into());
+    }
+    if unsafe { GetForegroundWindow() } != foreground {
+        return Err("Foreground changed during background placement; no show dispatched".into());
+    }
+    if owner(window) != pid || !live(process) {
+        return Err("Window/process changed during placement; no show dispatched".into());
+    }
+    validate(&ticket)?;
+    if unsafe { ShowWindowAsync(window, 4) } == 0 {
+        return Err("Non-activating restore failed".into());
+    }
+    for _ in 0..50 {
+        if unsafe { IsIconic(window) == 0 && IsWindowVisible(window) != 0 } {
+            break;
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+    if unsafe {
+        GetForegroundWindow() != foreground || IsIconic(window) != 0 || IsWindowVisible(window) == 0
+    } || !behind(window, foreground)
+        || owner(window) != pid
+        || !live(process)
+    {
+        return Err("Non-activating restoration not confirmed; action not dispatched".into());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod live_tests {
