+    #[test]
+    #[ignore = "Needs explicit PID of the current authorized dedicated Neo browser on the interactive desktop"]
+    fn actual_minimized_and_hidden_restoration_preserves_foreground_and_window() {
+        let pid = std::env::var("NEO_GUARD_TEST_PID")
+            .expect("exact authorized browser PID")
+            .parse::<u32>()
+            .expect("PID");
+        let mut search = Search {
+            pid,
+            windows: Vec::new(),
+        };
+        assert_ne!(
+            unsafe { EnumWindows(enumerate, (&mut search as *mut Search) as isize) },
+            0
+        );
+        assert_eq!(search.windows.len(), 1);
+        let window = search.windows[0];
+        let foreground = unsafe { GetForegroundWindow() };
+        assert!(!foreground.is_null() && foreground != window);
+        // SW_SHOWMINNOACTIVE and SW_HIDE affect only the verified Neo window.
+        for command in [7, 0] {
+            assert_ne!(unsafe { ShowWindowAsync(window, command) }, 0);
+            for _ in 0..50 {
+                let ready = unsafe {
+                    if command == 7 {
+                        IsIconic(window) != 0
+                    } else {
+                        IsWindowVisible(window) == 0
+                    }
+                };
+                if ready {
+                    break;
+                }
+                thread::sleep(Duration::from_millis(10));
+            }
+            assert!(
+                unsafe {
+                    if command == 7 {
+                        IsIconic(window) != 0
+                    } else {
+                        IsWindowVisible(window) == 0
+                    }
+                },
+                "Requested minimized/hidden start state not reached"
+            );
+            assert_eq!(unsafe { GetForegroundWindow() }, foreground);
+            restore(capture(pid).expect("capture exact existing HWND"))
+                .expect("non-activating restore of exact existing window");
+            assert_eq!(unsafe { GetForegroundWindow() }, foreground);
+            assert_eq!(owner(window), pid);
+            assert!(behind(window, foreground));
+            assert_eq!(unsafe { IsIconic(window) }, 0);
+            assert_ne!(unsafe { IsWindowVisible(window) }, 0);
+        }
+    }
