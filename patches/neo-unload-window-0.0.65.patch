+            .ok_or_else(|| CoreError::Message("Window mapping unavailable".into()))?
+            .iter()
+            .filter(|w| w.get("windowType").and_then(Value::as_str) == Some("normal"))
+            .collect::<Vec<_>>();
+        if checked.get("windowId").and_then(Value::as_i64) != Some(id)
+            || normal.len() != 1
+            || normal[0].get("windowId").and_then(Value::as_i64) != Some(id)
