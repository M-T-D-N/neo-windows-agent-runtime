+                    while ctx
+                        .session
+                        .page_signals
+                        .pending_dialog(&PageId(page))
+                        .is_none()
+                    {
+                        tokio::time::sleep(std::time::Duration::from_millis(25)).await;
+                    }
+                };
+                tokio::select! {
+                    biased;
+                    ()=dialog=>return Ok(Some(error_result("Close paused by a JavaScript dialog; binding preserved. Explicitly dismiss or accept before continuing"))),
+                    result=closing=>result?,
+                }
+
                 text_result(format!("closed page {page}"), Some(json!({ "page": page })))
             }
         };
