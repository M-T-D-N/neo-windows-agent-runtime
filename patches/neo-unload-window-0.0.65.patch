+        procedure: Option<unsafe extern "system" fn(Hwnd, u32, usize, isize) -> isize>,
+        class_extra: i32,
+        window_extra: i32,
+        instance: Hwnd,
+        icon: Hwnd,
+        cursor: Hwnd,
+        background: Hwnd,
+        menu: *const u16,
+        name: *const u16,
+    }
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn RegisterClassW(class: *const WindowClass) -> u16;
+        fn UnregisterClassW(name: *const u16, instance: Hwnd) -> i32;
+        fn CreateWindowExW(
+            exstyle: u32,
+            class: *const u16,
+            title: *const u16,
+            style: u32,
+            x: i32,
+            y: i32,
+            width: i32,
+            height: i32,
+            parent: Hwnd,
+            menu: Hwnd,
+            instance: Hwnd,
+            param: *mut c_void,
+        ) -> Hwnd;
+        fn DestroyWindow(window: Hwnd) -> i32;
+        fn DefWindowProcW(window: Hwnd, message: u32, wparam: usize, lparam: isize) -> isize;
+    }
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn GetModuleHandleW(name: *const u16) -> Hwnd;
+    }
+    struct HiddenWindows {
+        name: Vec<u16>,
+        instance: Hwnd,
+        windows: Vec<Hwnd>,
+    }
+    impl HiddenWindows {
+        fn new() -> Self {
+            let name = "Chrome_WidgetWin_1\0".encode_utf16().collect::<Vec<_>>();
+            let instance = unsafe { GetModuleHandleW(std::ptr::null()) };
+            let class = WindowClass {
+                style: 0,
+                procedure: Some(DefWindowProcW),
+                class_extra: 0,
+                window_extra: 0,
+                instance,
+                icon: std::ptr::null_mut(),
+                cursor: std::ptr::null_mut(),
+                background: std::ptr::null_mut(),
+                menu: std::ptr::null(),
+                name: name.as_ptr(),
+            };
+            assert_ne!(unsafe { RegisterClassW(&class) }, 0);
+            Self {
+                name,
+                instance,
+                windows: Vec::new(),
+            }
+        }
+        fn add(&mut self) -> Hwnd {
+            let title = "Neo hidden synthetic fixture\0"
+                .encode_utf16()
+                .collect::<Vec<_>>();
+            let window = unsafe {
+                CreateWindowExW(
+                    0,
+                    self.name.as_ptr(),
+                    title.as_ptr(),
+                    0x00CF0000,
+                    0,
+                    0,
+                    100,
+                    100,
+                    std::ptr::null_mut(),
+                    std::ptr::null_mut(),
+                    self.instance,
+                    std::ptr::null_mut(),
+                )
+            };
+            assert!(!window.is_null());
+            self.windows.push(window);
+            window
+        }
+        fn remove(&mut self, window: Hwnd) {
+            assert_ne!(unsafe { DestroyWindow(window) }, 0);
+            self.windows.retain(|w| *w != window);
+        }
+    }
+    impl Drop for HiddenWindows {
+        fn drop(&mut self) {
+            for window in &self.windows {
+                unsafe {
+                    DestroyWindow(*window);
+                }
+            }
+            unsafe {
+                UnregisterClassW(self.name.as_ptr(), self.instance);
+            }
+        }
+    }
+    #[test]
+    fn actual_hidden_replacement_and_multiple_candidates_are_rejected_without_showing() {
+        let mut windows = HiddenWindows::new();
+        let pid = std::process::id();
+        let foreground = unsafe { GetForegroundWindow() };
+        let old = windows.add();
+        let ticket = capture(pid).expect("capture original hidden fixture");
+        windows.remove(old);
+        let replacement = windows.add();
+        assert!(restore(ticket).is_err());
+        assert_eq!(unsafe { IsWindowVisible(replacement) }, 0);
+        assert_eq!(unsafe { GetForegroundWindow() }, foreground);
+        let _second = windows.add();
+        assert!(capture(pid).is_err());
+        for window in &windows.windows {
+            assert_eq!(unsafe { IsWindowVisible(*window) }, 0);
+        }
+        assert_eq!(unsafe { GetForegroundWindow() }, foreground);
+    }
