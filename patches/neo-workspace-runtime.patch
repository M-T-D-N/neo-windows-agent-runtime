+#[tokio::test]
+async fn navigation_dialog_returns_before_blocked_cdp_ack_for_granular_and_sdk() {
+    for tool in ["navigate", "run"] {
+        for action in ["url", "reload", "back", "forward"] {
+            let (ctx, connection, page) = harness_ctx().await;
+            connection
+                .emit_navigation_dialog
+                .store(true, Ordering::SeqCst);
+            let args = if tool == "navigate" {
+                json!({"page": page, "action": action, "url": "https://next.example/"})
+            } else {
+                let method = if action == "url" {
+                    "goto('https://next.example/')"
+                } else {
+                    match action {
+                        "reload" => "reload()",
+                        "back" => "back()",
+                        _ => "forward()",
+                    }
+                };
+                json!({"code": format!("return await browser.page({page}).{method};")})
+            };
+            let definition = tool_by_name(tool);
+            let result = tokio::time::timeout(
+                Duration::from_secs(1),
+                execute_tool(&definition, args, &ctx),
+            )
+            .await
+            .unwrap_or_else(|_| panic!("{tool}/{action} waited for blocked CDP ack"))
+            .unwrap_or_else(|err| panic!("{tool}/{action}: {err}"));
+            assert!(
+                !result.is_error,
+                "{tool}/{action}: {}",
+                result_text(&result)
+            );
+            let data = result.structured_content.expect("structured dialog result");
+            let marker = if tool == "run" { &data["value"] } else { &data };
+            assert_eq!(marker["dialogOpen"], true, "{tool}/{action}: {data}");
+            assert_eq!(marker["kind"], "beforeunload");
