+        let headerless_ping = serde_json::from_slice::<serde_json::Value>(&bytes)
+            .ok()
+            .is_some_and(|value| value["jsonrpc"] == "2.0" && value["method"] == "ping");
+        if headerless_ping {
+            return (StatusCode::NOT_FOUND, "HTTP session requires initialize").into_response();
+        }
+        Request::from_parts(parts, axum::body::Body::from(bytes))
+    } else {
+        req
