+    async fn restored_recovery_competing_callers_cannot_both_claim_new_incarnation()
+    -> anyhow::Result<()> {
+        let (call, _) = restored_fixture("closed", Some("server shutdown"), true, false).await?;
+        let other = call
+            .state
+            .sessions
+            .mint_with_id(
+                SessionId::new("rival"),
+                ClientIdentity::Ephemeral {
+                    slug: "codex".into(),
+                    label: "Codex".into(),
+                },
+                ClientInfo {
+                    name: "Codex".into(),
+                    version: "test".into(),
+                    title: None,
+                },
+            )
+            .await?;
+        let mut rival = call.clone();
+        rival.session_id = other.id().clone();
+        let identity = rival.identity.as_mut().unwrap();
+        identity.session = other.clone();
+        identity.ownership_key = other.convo_id().clone();
+        let (a, b) = tokio::join!(reclaim_enabled(&call), reclaim_enabled(&rival));
+        assert_ne!(a.is_error, b.is_error, "exactly one claimant must commit");
+        let rows = call
+            .state
+            .session_tabs
+            .list_open_session_tabs(&[call.session_id.as_str().into(), "rival".into()])
+            .await?;
+        assert_eq!(rows.len(), 1);
+        Ok(())
+    }
