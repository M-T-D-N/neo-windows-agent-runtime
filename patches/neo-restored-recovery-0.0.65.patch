+    pub async fn record_restored_recovery(&self, prior_session: &str, current_session: &str,
+        current_owner: &str, old_owner: &str, client: &str,
+        prior_tabs: &[(i64,String)], current_tabs: &[(i64,String)]) -> AppResult<bool> {
+        let txn=self.db.connection().begin().await?;
+        if closed_owner_in(&txn,prior_session,prior_tabs,true).await?
+            != Some((old_owner.to_owned(),client.to_owned())) {return Ok(false)}
+        for (tab,target) in current_tabs {
+            if SessionTabs::find().filter(session_tabs::Column::OpenedTargetId.eq(target.clone()))
+                .one(&txn).await?.is_some() {return Ok(false)}
+            if SessionTabs::find().filter(session_tabs::Column::TabId.eq(*tab))
+                .order_by_desc(session_tabs::Column::Id).one(&txn).await?
+                .is_some_and(|r|r.released_at.is_none()) {return Ok(false)}
+        }
+        let claimed=now_epoch_ms();
+        for (tab,target) in current_tabs {
+            SessionTabs::insert(session_tabs::ActiveModel {
+                id:NotSet,session_id:Set(current_session.to_owned()),agent_id:Set(current_owner.to_owned()),
+                tab_id:Set(*tab),opened_target_id:Set(Some(target.clone())),claimed_at:Set(claimed),released_at:Set(None),
+            }).exec(&txn).await?;
+        }
+        txn.commit().await?;
+        Ok(true)
+    }
