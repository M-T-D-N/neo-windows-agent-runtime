+            }
+            call.state
+                .sessions
+                .remove(
+                    &SessionId::new("prior-task"),
+                    "closed",
+                    Some("server shutdown"),
+                )
+                .await?;
+            recorder.restored.store(true, Ordering::SeqCst);
+            call.raw_args = json!({"action":"reclaim_restored","groupId":"restored-group",
+                "priorGroupId":"saved-group","priorSession":"prior-task",
+                "prior":[{"tabId":101,"targetId":"writer-target","url":"https://example.com/editor"}],
+                "expected":[{"targetId":"restored-target","url":"https://example.com/editor"}]});
+            if !subset {
+                call.state.session_tabs.enqueue_claim_tab_for_session(
